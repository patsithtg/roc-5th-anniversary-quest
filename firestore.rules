rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/state/main {
   function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
   allow read, delete: if owner();
   allow create, update: if owner() && request.resource.data.keys().hasOnly(['rev','data']) && request.resource.data.rev is int && request.resource.data.data is map && request.resource.data.data.keys().hasOnly(['accounts']) && request.resource.data.data.accounts is list && request.resource.data.data.accounts.size() <= 30;
  }
 }
}
